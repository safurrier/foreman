#!/usr/bin/env bash
# Unattended setup receipt. stdout is reserved for one JSON document.
set -u

SCRIPT_DIR="$(cd -P -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd -P -- "$SCRIPT_DIR/.." && pwd)"
REPORTER="$SCRIPT_DIR/entrypoint-report.py"
DOCTOR_FILE="$(mktemp "${TMPDIR:-/tmp}/foreman-agent-doctor.XXXXXX")"
trap 'rm -f "$DOCTOR_FILE"' EXIT HUP INT TERM

setup_status=passed
setup_exit=0
if ! command -v mise >/dev/null 2>&1; then
  setup_status=failed
  setup_exit=127
  printf '%s\n' "foreman agent setup: mise is not installed; install mise, then rerun $ROOT/.agents/setup" >&2
else
  printf '%s\n' 'foreman agent setup: running mise run setup' >&2
  (cd "$ROOT" && mise run setup) >&2
  setup_exit=$?
  if [ "$setup_exit" -ne 0 ]; then
    setup_status=failed
    printf '%s\n' "foreman agent setup: mise run setup failed; fix the diagnostic above, then rerun $ROOT/.agents/setup" >&2
  fi
fi

doctor_status=not-run
doctor_exit=0
doctor_receipt_file=""
if [ "$setup_status" = passed ]; then
  if ! command -v foreman >/dev/null 2>&1; then
    doctor_status=failed
    doctor_exit=127
    printf '%s\n' "foreman agent setup: foreman is not installed; run 'cd $ROOT && mise run install-local', then rerun $ROOT/.agents/setup" >&2
  else
    printf '%s\n' 'foreman agent setup: running strict Foreman doctor' >&2
    (cd "$ROOT" && foreman --doctor --doctor-json --doctor-strict --repo "$ROOT") >"$DOCTOR_FILE"
    doctor_exit=$?
    doctor_receipt_file="$DOCTOR_FILE"
    if ! python3 -m json.tool "$DOCTOR_FILE" >/dev/null 2>&1; then
      doctor_status=failed
      doctor_exit=1
      printf '%s\n' "foreman agent setup: doctor did not emit valid JSON; inspect stderr and rerun $ROOT/.agents/setup" >&2
    elif [ "$doctor_exit" -eq 0 ]; then
      doctor_status=passed
    else
      doctor_status=blocked
      printf '%s\n' "foreman agent setup: strict doctor blocked readiness; inspect the receipt and rerun $ROOT/.agents/setup after fixing findings" >&2
    fi
  fi
fi

FOREMAN_AGENT_SETUP_STATUS="$setup_status" \
FOREMAN_AGENT_SETUP_EXIT="$setup_exit" \
FOREMAN_AGENT_DOCTOR_STATUS="$doctor_status" \
FOREMAN_AGENT_DOCTOR_EXIT="$doctor_exit" \
FOREMAN_AGENT_DOCTOR_FILE="$doctor_receipt_file" \
python3 "$REPORTER" setup "$ROOT"
receipt_exit=$?
if [ "$receipt_exit" -ne 0 ]; then
  printf '%s\n' 'foreman agent setup: could not render JSON receipt' >&2
  exit "$receipt_exit"
fi

if [ "$setup_status" != passed ]; then
  exit "$setup_exit"
fi
if [ "$doctor_status" != passed ]; then
  exit "$doctor_exit"
fi
